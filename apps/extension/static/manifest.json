{
  "manifest_version": 3,
  "name": "Checkout money agent",
  "short_name": "Checkout agent",
  "version": "0.1.0",
  "description": "Steps in at the Amazon UK checkout with a regret score and what the basket does to your money before payday.",
  "permissions": ["storage", "activeTab", "commands"],
  "host_permissions": ["https://www.amazon.co.uk/*", "http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.uk/gp/buy/*",
        "https://www.amazon.co.uk/cart/*",
        "https://www.amazon.co.uk/gp/cart/*",
        "https://www.amazon.co.uk/gp/aw/c*",
        "https://www.amazon.co.uk/checkout/*",
        "http://localhost:3000/test-checkout.html*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Checkout money agent",
    "default_popup": "popup.html"
  },
  "commands": {
    "judge-now": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Judge this screen now"
    }
  }
}
